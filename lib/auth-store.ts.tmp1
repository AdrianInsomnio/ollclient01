import { create } from 'zustand'
import { persist } from 'zustand/middleware'
import { AUTH_VIA_COOKIE } from './auth-config'
import { login } from './api/auth'

export type UserRole = 'USER' | 'VET' | 'ADMIN' | 'SUPER_ADMIN'

export interface User {
  id: number
  username: string
  email: string
  role: UserRole
  organizationId: number
}

interface AuthState {
  /**
   * Token persistido solo en modo legacy (Authorization header). En modo
   * cookie (AUTH_VIA_COOKIE=true) este campo queda en null porque el JWT
   * vive en la cookie HttpOnly que el cliente JS no puede leer.
   */
  token: string | null
  user: User | null
  tenantId: string | null
  isAuthenticated: boolean
  checking: boolean
  login: (token: string | null, user: User) => void
  logout: () => void
  initialize: () => Promise<void>
}

export const useAuthStore = create<AuthState>()(
  persist(
    (set, get) => ({
      token: null,
      user: null,
      tenantId: null,
      isAuthenticated: false
      checking: true
      login: (token, user) =>
        set({
          // En modo cookie ignoramos el token: el cliente no debe guardar
          // el JWT en localStorage. La cookie HttpOnly es la unica fuente
          // de verdad.
          token: AUTH_VIA_COOKIE ? null : token
          user
          tenantId: String(user.organizationId)
          isAuthenticated: true
          checking: false
        })
      logout: () =>
        set({
          token: null
          user: null
          tenantId: null
          isAuthenticated: false
          checking: false
        })
      initialize: async () => {
        // Si ya terminamos de verificar, no hacemos nada
        const state = get()
        if (!state.checking) return

        try {
          // Intentamos hacer una petición a un endpoint protegido para verificar la autenticación
          // Usamos el endpoint de métricas del admin como prueba
          const response = await fetch('/api/admin/dashboard/metrics', {
            credentials: 'include' // Importante para enviar cookies
          })

          if (response.ok) {
            // La petición fue exitosa, así que estamos autenticados
            // Necesitamos obtener los datos del usuario
            const authResponse = await response.json()
            // Asumimos que la respuesta tiene el formato de AuthResponse
            if (authResponse.user) {
              set({
                token: AUTH_VIA_COOKIE ? null : authResponse.token ?? null
                user: authResponse.user
                tenantId: String(authResponse.user.organizationId)
                isAuthenticated: true
                checking: false
              })
              return
            }
          }

          // Si llegamos aquí, no estamos autenticados
          set({
            token: null
            user: null
            tenantId: null
            isAuthenticated: false
            checking: false
          })
        } catch (error) {
          // En caso de error, asumimos que no estamos autenticados
          console.warn('Auth initialization failed:', error)
          set({
            token: null
            user: null
            tenantId: null
            isAuthenticated: false
            checking: false
          })
        }
      }
    }))
    {
      name: 'auth-storage'
      // En modo cookie solo persistimos `user` + `tenantId` + flag de
      // autenticacion. El token no se persiste (no debe estar en el
      // storage del navegador). Esto evita que un XSS robe el JWT y, 
      // ademas, garantiza que un reload del navegador mantenga al usuario
      // identificado mientras la cookie siga viva.
      // No persistimos el estado de checking
      partialize: (state) => {
        if (AUTH_VIA_COOKIE) {
          return {
            user: state.user
            tenantId: state.tenantId
            isAuthenticated: state.isAuthenticated
          }
        }
        return {
          token: state.token
          user: state.user
          tenantId: state.tenantId
          isAuthenticated: state.isAuthenticated
        }
      }
    }
  )
)
